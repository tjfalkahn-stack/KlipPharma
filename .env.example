OPENAI_API_KEY=
PORT=3100
AI_TEXT_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=whisper-1
AI_SPEECH_MODEL=gpt-4o-mini-tts

# Local development defaults to one private local owner with no sign-in screen.
# For production, set AUTH_MODE=required and add a PostgreSQL connection string.
AUTH_MODE=off
DATABASE_URL=
PGSSLMODE=require
DB_POOL_SIZE=10
SESSION_DAYS=30
NODE_ENV=development
STORAGE_ROOT=
APP_BASE_URL=https://app.klippharma.com

# TikTok Login Kit + Content Posting API. TIKTOK_CLIENT_SECRET is server-only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.klippharma.com/api/integrations/tiktok/oauth/callback
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.upload,video.publish

# YouTube OAuth + Data API v3. YOUTUBE_CLIENT_SECRET is server-only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://app.klippharma.com/api/integrations/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.upload

# Server-to-server Klipdose handoffs.
# This must match Klipdose's KLIPPHARMA_API_KEY and must never be exposed client-side.
KLIPDOSE_SHARED_API_KEY=
# Optional owner used when Klipdose creates projects in production account mode.
KLIPDOSE_PROJECT_OWNER_ID=

# Optional authenticated YouTube access for server-side yt-dlp imports.
# Railway/production: base64-encode a Netscape-format cookies.txt file.
YOUTUBE_COOKIES_BASE64=
# Local development only: absolute path to a Netscape-format cookies.txt file.
YTDLP_COOKIES_FILE=

# Temporary pre-payment beta access. Set to false when paid-plan enforcement launches.
PRO_FEATURES_OPEN=true

# Stripe recurring subscriptions. The legacy STRIPE_PRO_PRICE_ID can still supply
# the $29 Creator monthly price while existing installations migrate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_MONTHLY_PRICE_ID=
STRIPE_CREATOR_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
STRIPE_CREATOR_MONTHLY_PRICE_LABEL=$29/month
STRIPE_CREATOR_YEARLY_PRICE_LABEL=$290/year
STRIPE_PRO_MONTHLY_PRICE_LABEL=$79/month
STRIPE_PRO_YEARLY_PRICE_LABEL=$790/year
STRIPE_BUSINESS_MONTHLY_PRICE_LABEL=$199/month
STRIPE_BUSINESS_YEARLY_PRICE_LABEL=$1,990/year
# Create a 15% off, duration-once coupon and paste its coupon ID here.
STRIPE_PRO_UPGRADE_COUPON_ID=

# Optional private Cloudflare R2 direct uploads. Set all five in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
